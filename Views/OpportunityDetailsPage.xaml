<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VolunteerConnect.Views.OpportunityDetailsPage"
             Title="Opportunity Details">

       <ScrollView>
              <VerticalStackLayout Padding="20"
                            Spacing="8">

                     <Border StrokeShape="RoundRectangle 12"
                                   StrokeThickness="0">
                            <Image x:Name="DetailImage"
                                          HeightRequest="180"
                                          Aspect="AspectFill"/>
                     </Border>

                     <Label x:Name="DetailTitle"
                                   Style="{StaticResource CardTitleStyle}"
                                   FontSize="22"/>

                     <HorizontalStackLayout Spacing="4">
                            <Label Text="&#127991;&#65039;"
                                          FontSize="14"/>
                            <Label x:Name="DetailCategory"
                                          Style="{StaticResource CardSubtitleStyle}"/>
                     </HorizontalStackLayout>

                     <Label Text="&#128197;  Date &amp; Time"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   FontSize="16"/>
                     <Label x:Name="DetailDateTime"
                                   Style="{StaticResource BodyTextStyle}"/>

                     <Label Text="&#128205;  Location"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   FontSize="16"/>
                     <Label x:Name="DetailLocation"
                                   Style="{StaticResource BodyTextStyle}"/>

                     <Label Text="&#128221;  Description"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   FontSize="16"/>
                     <Label x:Name="DetailDescription"
                                   Style="{StaticResource BodyTextStyle}"/>

                     <Label Text="&#9989;  Requirements"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   FontSize="16"/>
                     <Label x:Name="DetailRequirements"
                                   Style="{StaticResource BodyTextStyle}"/>

                     <HorizontalStackLayout Spacing="4"
                                   Margin="0,4,0,0">
                            <Label Text="&#128101;"
                                          FontSize="14"/>
                            <Label x:Name="DetailPlaces"
                                          Style="{StaticResource BodyTextStyle}"
                                          FontAttributes="Bold"/>
                     </HorizontalStackLayout>

                     <Button x:Name="RegisterButton"
                             Text="Register Interest"
                             Margin="0,16,0,0"
                             Clicked="OnRegisterClicked"/>

              </VerticalStackLayout>
       </ScrollView>

</ContentPage>