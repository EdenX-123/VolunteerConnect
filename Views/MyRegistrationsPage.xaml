<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:VolunteerConnect.Models"
             x:Class="VolunteerConnect.Views.MyRegistrationsPage"
             Title="My Registrations">

       <CollectionView x:Name="RegistrationsCollectionView"
                       Margin="16">
              <CollectionView.ItemTemplate>
                     <DataTemplate x:DataType="models:VolunteerRegistration">
                            <Border Style="{StaticResource CardFrameStyle}">
                                   <Border.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="OnMyRegistrationsTapped"
                                                                CommandParameter="{Binding Id}"/>
                                   </Border.GestureRecognizers>
                                   <VerticalStackLayout Spacing="2">
                                          <Label Text="{Binding PreferredName}"
                                                 Style="{StaticResource CardTitleStyle}"/>
                                          <Label Text="{Binding ContactDetail}"
                                                 Style="{StaticResource CardSubtitleStyle}"/>
                                          <Label Text="{Binding Availability}"
                                                 Style="{StaticResource CardSubtitleStyle}"/>
                                          <Label Text="{Binding RegistrationDate, StringFormat='Registered {0:dd MMM yyyy}'}"
                                                 Style="{StaticResource CardSubtitleStyle}"/>
                                   </VerticalStackLayout>
                            </Border>
                     </DataTemplate>
              </CollectionView.ItemTemplate>

              <CollectionView.EmptyView>
                     <Label Text="You have no saved registrations yet."
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Style="{StaticResource BodyTextStyle}"/>
              </CollectionView.EmptyView>
       </CollectionView>
</ContentPage>