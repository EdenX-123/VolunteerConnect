<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:VolunteerConnect.Models"
             x:Class="VolunteerConnect.Views.OpportunitiesPage"
             Title="Opportunities">

       <Grid RowDefinitions="Auto,*"
             Padding="16"
             RowSpacing="10">

              <!-- Search bar: the "at least one search/filter" requirement -->
              <SearchBar x:Name="SearchBox"
                         Grid.Row="0"
                         Placeholder="Search by title..."
                         TextChanged="OnSearchTextChanged"/>

              <CollectionView x:Name="OpportunitiesCollectionView"
                              Grid.Row="1"
                              SelectionMode="None">
                     <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:VolunteerOpportunity">
                                   <Border Style="{StaticResource CardFrameStyle}"
                                           HeightRequest="200">
                                          <Border.GestureRecognizers>
                                                 <TapGestureRecognizer Tapped="OnOpportunityTapped"
                                                                       CommandParameter="{Binding Id}"/>
                                          </Border.GestureRecognizers>

                                          <Grid ColumnDefinitions="90,*"
                                                ColumnSpacing="12">

                                                 <Border StrokeShape="RoundRectangle 12"
                                                         StrokeThickness="0"
                                                         WidthRequest="90"
                                                         Grid.Column="0">
                                                        <Image
                                                               Aspect="AspectFill"
                                                               Source="{Binding ImageName}"/>
                                                 </Border>

                                                 <VerticalStackLayout Grid.Column="1"
                                                                      Spacing="2"
                                                                      Padding="10">
                                                        <Label Text="{Binding Title}"
                                                               Style="{StaticResource CardTitleStyle}"/>
                                                        <Label Text="{Binding Category}"
                                                               Style="{StaticResource CardSubtitleStyle}"/>
                                                        <Label Text="{Binding Location}"
                                                               Style="{StaticResource CardSubtitleStyle}"/>
                                                        <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}"
                                                               Style="{StaticResource CardSubtitleStyle}"/>
                                                        <Label Text="{Binding Time}"
                                                               Style="{StaticResource CardSubtitleStyle}"/>
                                                        <Label Text="{Binding Description}"
                                                               Style="{StaticResource BodyTextStyle}"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="1"/>
                                                        <Label Text="{Binding AvailablePlaces, StringFormat='{0} places available'}"
                                                               Style="{StaticResource CardSubtitleStyle}"/>
                                                        <Label Text="Available"
                                                               Style="{StaticResource StatusAvailableStyle}"
                                                               IsVisible="{Binding IsAvailable}"/>
                                                        <Label Text="Full"
                                                               Style="{StaticResource StatusFullStyle}"
                                                               IsVisible="{Binding IsAvailable, Converter={StaticResource InvertedBoolConverter}}"/>
                                                 </VerticalStackLayout>
                                          </Grid>
                                   </Border>
                            </DataTemplate>
                     </CollectionView.ItemTemplate>

                     <CollectionView.EmptyView>
                            <Label Text="No opportunities match your search."
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Style="{StaticResource BodyTextStyle}"/>
                     </CollectionView.EmptyView>
              </CollectionView>

       </Grid>

</ContentPage>
