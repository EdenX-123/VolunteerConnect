<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:VolunteerConnect.Models"
             x:Class="VolunteerConnect.Views.OpportunitiesPage"
             Title="Opportunities">

       <Grid RowDefinitions="Auto,*"
             Padding="16"
             RowSpacing="10">

              <!-- Search bar: the "at least one search/filter" requirement -->
              <SearchBar x:Name="SearchBox"
                         Grid.Row="0"
                         Placeholder="Search by title..."
                         TextChanged="OnSearchTextChanged"
                         Margin="-20,0,0,0"
                         />

              <CollectionView x:Name="OpportunitiesCollectionView"
                              Grid.Row="1"
                              SelectionMode="None">
                     <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:VolunteerOpportunity">
                                   <Border Style="{StaticResource CardFrameStyle}"
                                           Padding="0">

                                          <Border.GestureRecognizers>
                                                 <TapGestureRecognizer Tapped="OnOpportunityTapped"
                                                                       CommandParameter="{Binding Id}"/>
                                          </Border.GestureRecognizers>

                                          <VerticalStackLayout Spacing="0">

                                                 <Grid HeightRequest="180">

                                                        <Image Aspect="AspectFill"
                                                               Source="{Binding ImageName}"/>

                                                        <Border StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 20"
                                                                BackgroundColor="#ECFDF3"
                                                                Padding="10,5"
                                                                Margin="12"
                                                                HorizontalOptions="Start"
                                                                VerticalOptions="Start"
                                                                IsVisible="{Binding IsAvailable}">
                                                               <Label Text="Available"
                                                                      TextColor="#16A34A"
                                                                      FontSize="12"
                                                                      FontAttributes="Bold"/>
                                                        </Border>

                                                        <Border StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 20"
                                                                BackgroundColor="#FEF2F2"
                                                                Padding="10,5"
                                                                Margin="12"
                                                                HorizontalOptions="Start"
                                                                VerticalOptions="Start"
                                                                IsVisible="{Binding IsAvailable, Converter={StaticResource InvertedBoolConverter}}">
                                                               <Label Text="   Full   "
                                                                      TextColor="#DC2626"
                                                                      FontSize="12"
                                                                      FontAttributes="Bold"/>
                                                        </Border>

                                                 </Grid>


                                                 <VerticalStackLayout Spacing="4"
                                                               Padding="14">

                                                        <Label Text="{Binding Title}"
                                                               Style="{StaticResource CardTitleStyle}"
                                                               FontSize="18"/>

                                                        <HorizontalStackLayout Spacing="4">
                                                               <Label Text="&#127991;&#65039;"
                                                                             FontSize="13"/>
                                                               <Label Text="{Binding Category}"
                                                                      Style="{StaticResource CardSubtitleStyle}"/>
                                                        </HorizontalStackLayout>

                                                        <HorizontalStackLayout Spacing="4">
                                                               <Label Text="&#128205;"
                                                                             FontSize="13"/>
                                                               <Label Text="{Binding Location}"
                                                                      Style="{StaticResource CardSubtitleStyle}"/>
                                                        </HorizontalStackLayout>

                                                        <HorizontalStackLayout Spacing="10">
                                                               <HorizontalStackLayout Spacing="4">
                                                                      <Label Text="&#128197;"
                                                                                    FontSize="13"/>
                                                                      <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}"
                                                                             Style="{StaticResource CardSubtitleStyle}"/>
                                                               </HorizontalStackLayout>
                                                               <HorizontalStackLayout Spacing="4">
                                                                      <Label Text="&#128337;"
                                                                                    FontSize="13"/>
                                                                      <Label Text="{Binding Time}"
                                                                             Style="{StaticResource CardSubtitleStyle}"/>
                                                               </HorizontalStackLayout>
                                                        </HorizontalStackLayout>

                                                        <Label Text="{Binding Description}"
                                                               Style="{StaticResource BodyTextStyle}"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="2"
                                                               Margin="0,4,0,0"/>

                                                        <HorizontalStackLayout Spacing="4"
                                                                      Margin="0,4,0,0">
                                                               <Label Text="&#128101;"
                                                                             FontSize="13"/>
                                                               <Label Text="{Binding AvailablePlaces, StringFormat='{0} places available'}"
                                                                      FontSize="13"
                                                                      FontAttributes="Bold"/>
                                                        </HorizontalStackLayout>

                                                 </VerticalStackLayout>

                                          </VerticalStackLayout>
                                   </Border>
                            </DataTemplate>
                     </CollectionView.ItemTemplate>

                     <CollectionView.EmptyView>
                            <Label Text="No opportunities match your search."
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Style="{StaticResource BodyTextStyle}"/>
                     </CollectionView.EmptyView>
              </CollectionView>

       </Grid>

</ContentPage>
