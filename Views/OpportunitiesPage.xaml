<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:VolunteerConnect.Models"
             x:Class="VolunteerConnect.Views.OpportunitiesPage"
             Title="Opportunities">

       <Grid RowDefinitions="Auto,*"
                     Padding="16"
                     RowSpacing="10">

              <!-- Search bar: the "at least one search/filter" requirement -->
              <SearchBar x:Name="SearchBox"
                         Grid.Row="0"
                         Placeholder="Search by title..."
                         TextChanged="OnSearchTextChanged"/>

              <CollectionView x:Name="OpportunitiesCollectionView"
                              Grid.Row="1"
                              SelectionMode="None">
                     <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:VolunteerOpportunity">
                                   <Frame Style="{StaticResource CardFrameStyle}">
                                          <Frame.GestureRecognizers>
                                                 <TapGestureRecognizer Tapped="OnOpportunityTapped"
                                                                       CommandParameter="{Binding Id}"/>
                                          </Frame.GestureRecognizers>

                                          <Grid ColumnDefinitions="90,*"
                                                        ColumnSpacing="12">

                                                 <Border StrokeShape="RoundRectangle 30"
                                                         StrokeThickness="0"
                                                         Padding="10">

                                                        <Image Grid.Column="0"
                                                               Source="{Binding ImageName}"
                                                               Style="{StaticResource CardImageStyle}"
                                                               HeightRequest="90"
                                                                      WidthRequest="90"/>
                                                 </Border>

                                                 <VerticalStackLayout Grid.Column="1"
                                                               Spacing="2">
                                                        <Label Text="{Binding Title}"
                                                                      Style="{StaticResource CardTitleStyle}"/>
                                                        <Label Text="{Binding Category}"
                                                                      Style="{StaticResource CardSubtitleStyle}"/>
                                                        <Label Text="{Binding Location}"
                                                                      Style="{StaticResource CardSubtitleStyle}"/>
                                                        <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}"
                                                               Style="{StaticResource CardSubtitleStyle}"/>

                                                        <Label Text="Available"
                                                               Style="{StaticResource StatusAvailableStyle}"
                                                               IsVisible="{Binding IsAvailable}"/>
                                                        <Label Text="Full"
                                                               Style="{StaticResource StatusFullStyle}"
                                                               IsVisible="{Binding IsAvailable, Converter={StaticResource InvertedBoolConverter}}"/>
                                                 </VerticalStackLayout>
                                          </Grid>
                                   </Frame>
                            </DataTemplate>
                     </CollectionView.ItemTemplate>

                     <CollectionView.EmptyView>
                            <Label Text="No opportunities match your search."
                                   HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                   Style="{StaticResource BodyTextStyle}"/>
                     </CollectionView.EmptyView>
              </CollectionView>

       </Grid>

</ContentPage>
