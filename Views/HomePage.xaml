<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VolunteerConnect.Views.HomePage"
             Title="Home">

       <ScrollView>
              <VerticalStackLayout Padding="20"
                            Spacing="12">

                     <Label Text="Welcome to the VolunteerConnect App"
                            FontSize="24"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"/>

                     <Label Text="This is an app that helps you find volunteer opportunities"
                            FontSize="16"
                            HorizontalTextAlignment="Center"/>

                     <Label Text="Featured Opportunity"
                            FontSize="18"
                            FontAttributes="Bold"
                            Margin="10,10,0,0"/>

                     <Border Style="{StaticResource CardFrameStyle}"
                             Padding="0">

                            <Border.GestureRecognizers>
                                   <TapGestureRecognizer Tapped="OnFeaturedCardTapped"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="0">

                                   <Grid HeightRequest="180">

                                          <Image x:Name="FeaturedImage"
                                                 Aspect="AspectFill"/>

                                          <Border x:Name="FeaturedAvailableBadge"
                                                  StrokeThickness="0"
                                                  StrokeShape="RoundRectangle 20"
                                                  BackgroundColor="#ECFDF3"
                                                  Padding="10,5"
                                                  Margin="12"
                                                  HorizontalOptions="Start"
                                                  VerticalOptions="Start">
                                                 <Label Text="Available"
                                                        TextColor="#16A34A"
                                                        FontSize="12"
                                                        FontAttributes="Bold"/>
                                          </Border>

                                   </Grid>

                                   <VerticalStackLayout Spacing="4"
                                                 Padding="14">

                                          <Label x:Name="FeaturedTitleLabel"
                                                 Style="{StaticResource CardTitleStyle}"
                                                 FontSize="18"/>

                                          <HorizontalStackLayout Spacing="4">
                                                 <Label Text="&#127991;&#65039;"
                                                               FontSize="13"/>
                                                 <Label x:Name="FeaturedCategoryLabel"
                                                        Style="{StaticResource CardSubtitleStyle}"/>
                                          </HorizontalStackLayout>

                                          <HorizontalStackLayout Spacing="4">
                                                 <Label Text="&#128205;"
                                                               FontSize="13"/>
                                                 <Label x:Name="FeaturedLocationLabel"
                                                        Style="{StaticResource CardSubtitleStyle}"/>
                                          </HorizontalStackLayout>

                                          <HorizontalStackLayout Spacing="10">
                                                 <HorizontalStackLayout Spacing="4">
                                                        <Label Text="&#128197;"
                                                                      FontSize="13"/>
                                                        <Label x:Name="FeaturedDateLabel"
                                                               Style="{StaticResource CardSubtitleStyle}"/>
                                                 </HorizontalStackLayout>
                                                 <HorizontalStackLayout Spacing="4">
                                                        <Label Text="&#128337;"
                                                                      FontSize="13"/>
                                                        <Label x:Name="FeaturedTimeLabel"
                                                               Style="{StaticResource CardSubtitleStyle}"/>
                                                 </HorizontalStackLayout>
                                          </HorizontalStackLayout>

                                          <Label x:Name="FeaturedDescriptionLabel"
                                                 Style="{StaticResource BodyTextStyle}"
                                                 LineBreakMode="TailTruncation"
                                                 MaxLines="2"
                                                 Margin="0,4,0,0"/>

                                          <HorizontalStackLayout Spacing="4"
                                                        Margin="0,4,0,0">
                                                 <Label Text="&#128101;"
                                                               FontSize="13"/>
                                                 <Label x:Name="FeaturedPlacesLabel"
                                                        FontSize="13"
                                                        FontAttributes="Bold"/>
                                          </HorizontalStackLayout>

                                   </VerticalStackLayout>

                            </VerticalStackLayout>
                     </Border>

                     <Label x:Name="OpportunitiesCountLabel"
                            FontSize="16"
                            Margin="0,10,0,0"/>

                     <Button Text="Browse Opportunities"
                             Clicked="OnBrowseOpportunitiesClicked"
                             Margin="0,10,0,0"/>

              </VerticalStackLayout>
       </ScrollView>
</ContentPage>