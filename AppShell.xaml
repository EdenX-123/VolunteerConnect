<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VolunteerConnect.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:VolunteerConnect.Views"
    xmlns:local="clr-namespace:VolunteerConnect"
    Title="VolunteerConnect">
    
    <ShellContent 
        Title="Home" 
        Icon="house.svg"
        ContentTemplate="{DataTemplate 
        views:HomePage}" 
        Route="HomePage"/>

    <ShellContent 
        Title="Opportunities" 
        Icon="search.svg"
        ContentTemplate="{DataTemplate 
        views:OpportunitiesPage}" 
        Route="OpportunitiesPage"/>

    <ShellContent 
        Title="My Registrations" 
        Icon="person.svg"
        ContentTemplate="{DataTemplate 
        views:MyRegistrationsPage}" 
        Route="MyRegistrationsPage"/>

    <ShellContent 
        Title="Privacy" 
        Icon="shield.svg"
        ContentTemplate="{DataTemplate 
        views:PrivacyInfoPage}" 
        Route="PrivacyInfoPage"/>

</Shell>
